# Copie este arquivo para backend/.env e ajuste os valores na outra máquina.
# Execute os comandos npm da raiz do projeto. Não versione o .env preenchido.

# Obrigatório: crie o banco PostgreSQL em UTF-8, com suporte a ICU.
# Substitua USUARIO e SENHA pelas credenciais locais.
# Caracteres especiais nas credenciais devem usar codificação de URL (ex.: @ = %40).
# As duas variáveis são necessárias: DATABASE_URL para a API e DIRECT_URL para
# migrations e ferramentas Prisma. No PostgreSQL local, use a mesma URL nas duas.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/portal_all?schema=public"
DIRECT_URL="postgresql://USUARIO:SENHA@localhost:5432/portal_all?schema=public"

# Banco compartilhado em nuvem (Supabase): use a URL "Session pooler" acima na API.
# Use a URL "Direct connection" como DIRECT_URL para migrations e ferramentas
# administrativas. Nunca versione nenhuma das duas conexões preenchidas.

# Servidor local. O proxy em frontend/vite.config.ts aponta para a porta 3001.
PORT=3001
NODE_ENV=development

# Origem exata usada no navegador, sem caminho ou barra final.
# Desenvolvimento com Vite: http://localhost:5173
# Frontend compilado servido pelo backend local: http://localhost:3001
# Em produção: use a origem HTTPS do site e NODE_ENV=production.
# NODE_ENV=production exige HTTPS para o cookie de login.
# Configurações inválidas de PORT, NODE_ENV ou FRONTEND_URL impedem a inicialização.
FRONTEND_URL=http://localhost:5173

# Desenvolvimento com PostgreSQL local: sem R2, uploads ficam em backend/uploads.
# Banco remoto (inclusive Supabase) ou produção: configure R2; sem configuração,
# novos uploads retornam 503 para evitar arquivos disponíveis em apenas uma máquina.
# Alternativa: UPLOAD_DIR explícito tem prioridade sobre R2. Use somente em um
# backend central com disco persistente ou em testes locais isolados. O diretório
# não é sincronizado pelo Supabase nem pelo Git. Use um caminho absoluto gravável.
# UPLOAD_DIR="C:/dados/portal-all/uploads"

# Cloudflare R2. Quando as cinco variáveis estiverem definidas, uploads
# passam a ser gravados no bucket em vez do disco local. R2_PUBLIC_URL deve ser a
# URL HTTPS pública do bucket ou domínio personalizado, sem credenciais, query
# ou fragmento. R2_ACCOUNT_ID é o ID da conta: 32 caracteres hexadecimais.
# Configuração parcial ou inválida impede o upload; não muda para disco silenciosamente.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="portal-all-acervo"
# R2_PUBLIC_URL="https://acervo.exemplo.org"

# Conta administrativa: variáveis usadas somente pelo comando admin:account.
# Nenhuma conta é criada automaticamente ao iniciar a aplicação.
# Defina ADMIN_EMAIL e ADMIN_PASSWORD temporariamente no terminal e execute:
# npm --prefix backend run admin:account -- create
# Senha: 15 a 128 caracteres. Veja o passo a passo em backend/ADMIN_API.md.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""
# ADMIN_PERFIS="ADMINISTRADOR"
# ADMIN_PERFIS é usado só na CLI. Sem ele, novas contas recebem CONSULTA.
# Para combinar funções: ADMIN_PERFIS="EDITOR,SECRETARIA".

# Dados demonstrativos opcionais: habilite apenas ao executar db:seed.
# SEED_DEMO=true
# Carga exclusiva de apresentação: 40 cadeiras e 20 livros, sem notícias/eventos.
# SEED_PRESENTATION=true

# Testes de integração: defina TEST_DATABASE_URL no terminal, conforme o README.
# O runner exige um banco exclusivo com "test" no nome e substitui DATABASE_URL
# e DIRECT_URL dos subprocessos pelo mesmo schema temporário de TEST_DATABASE_URL.
# Assim, migrations e consultas não usam as conexões da aplicação em .env.
# TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/portal_all_test"
