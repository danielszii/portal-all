# Copie este arquivo para backend/.env e ajuste os valores na outra máquina.
# Execute os comandos npm da raiz do projeto. Não versione o .env preenchido.

# Obrigatório: crie o banco PostgreSQL em UTF-8, com suporte a ICU.
# Substitua USUARIO e SENHA pelas credenciais locais.
# Caracteres especiais nas credenciais devem usar codificação de URL (ex.: @ = %40).
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/portal_all?schema=public"

# Servidor local. O proxy em frontend/vite.config.ts aponta para a porta 3001.
PORT=3001
NODE_ENV=development

# Origem exata usada no navegador, sem caminho ou barra final.
# Desenvolvimento com Vite: http://localhost:5173
# Frontend compilado servido pelo backend local: http://localhost:3001
# Em produção: use a origem HTTPS do site e NODE_ENV=production.
# NODE_ENV=production exige HTTPS para o cookie de login.
FRONTEND_URL=http://localhost:5173

# Opcional: sem esta variável, os uploads ficam em backend/uploads.
# Para outro diretório, use um caminho absoluto com permissão de escrita.
# UPLOAD_DIR="C:/dados/portal-all/uploads"

# Conta administrativa: variáveis usadas somente pelo comando admin:account.
# Nenhuma conta é criada automaticamente ao iniciar a aplicação.
# Defina ADMIN_EMAIL e ADMIN_PASSWORD temporariamente no terminal e execute:
# npm --prefix backend run admin:account -- create
# Senha: 15 a 128 caracteres. Veja o passo a passo em backend/ADMIN_API.md.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""

# Dados demonstrativos opcionais: habilite apenas ao executar db:seed.
# SEED_DEMO=true

# Testes de integração: defina TEST_DATABASE_URL no terminal, conforme o README.
# A suíte não carrega .env e exige um banco exclusivo com "test" no nome.
# TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/portal_all_test"
